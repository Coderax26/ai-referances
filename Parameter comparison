
-- Oracle RAC Parameter Comparison
-- Compare visible and hidden parameters across four RAC instances.
-- Execute as SYSDBA using SQL*Plus or SQLcl.

SET LINESIZE 300
SET PAGESIZE 500
SET TRIMSPOOL ON
SET TAB OFF

COLUMN PARAMETER_NAME FORMAT A45
COLUMN INST1 FORMAT A35
COLUMN INST2 FORMAT A35
COLUMN INST3 FORMAT A35
COLUMN INST4 FORMAT A35
COLUMN STATUS FORMAT A12

-- Verify actual instance IDs before execution.
-- SELECT INST_ID, INSTANCE_NAME, HOST_NAME, STATUS
-- FROM GV$INSTANCE ORDER BY INST_ID;

WITH ALL_PARAMS AS
(
    -- Visible initialization parameters
    SELECT
        INST_ID,
        NAME AS PARAMETER_NAME,
        VALUE AS PARAMETER_VALUE
    FROM GV$PARAMETER

    UNION ALL

    -- Hidden underscore parameters
    SELECT
        X.INST_ID,
        X.KSPPINM AS PARAMETER_NAME,
        Y.KSPPSTVL AS PARAMETER_VALUE
    FROM X$KSPPI X
    JOIN X$KSPPCV Y
      ON Y.INDX = X.INDX
     AND Y.INST_ID = X.INST_ID
    WHERE X.KSPPINM LIKE '\_%' ESCAPE '\'
)
SELECT
    PARAMETER_NAME,
    MAX(CASE WHEN INST_ID = 1
        THEN PARAMETER_VALUE END) AS INST1,
    MAX(CASE WHEN INST_ID = 2
        THEN PARAMETER_VALUE END) AS INST2,
    MAX(CASE WHEN INST_ID = 3
        THEN PARAMETER_VALUE END) AS INST3,
    MAX(CASE WHEN INST_ID = 4
        THEN PARAMETER_VALUE END) AS INST4,
    CASE
        WHEN COUNT(DISTINCT INST_ID) = 4
         AND COUNT(DISTINCT NVL(PARAMETER_VALUE, '<NULL>')) = 1
        THEN 'MATCH'
        ELSE 'MISMATCH'
    END AS STATUS
FROM ALL_PARAMS
GROUP BY PARAMETER_NAME
ORDER BY PARAMETER_NAME;
